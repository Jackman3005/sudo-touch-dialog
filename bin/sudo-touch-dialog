#!/usr/bin/python
"""GTK4/Adwaita auth dialog for sudo with YubiKey + password fallback.

Runs the actual sudo command itself (single-sudo flow); the wrapper is a
thin shim. This sidesteps sudo's tty-tied timestamp behavior, which
prevents the timestamp from being shared across parent processes when
there is no controlling terminal (Claude Code's case).

Three states (auto-detected at startup):
  cached   - timestamp fresh; click Approve runs `sudo -n -- cmd`.
  touch    - YubiKey present; runs `sudo -A -- cmd` so pam_u2f waits
             for tap. User can switch to password fallback.
  password - no YubiKey; prompt for password and run `sudo -S -- cmd`.

Exit codes:
  Whatever sudo returns (forwarding the command's exit code).
  77 if the user explicitly cancelled (REJECTED).
"""

import os
import re
import shlex
import signal
import subprocess
import sys
import threading
import time

import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402


# Strings sudo / pam_u2f write to stderr that we don't want surfaced to
# the user — the dialog already conveys all of this visually.
_DROP_STRINGS = [
    b'Please touch the FIDO authenticator.\n',
    b'Please touch the FIDO authenticator.',
]
_DROP_RES = [
    re.compile(rb'\[sudo\] password for [^:]+:[ \t]*'),
    re.compile(rb'Sorry, try again\.\n?'),
    re.compile(rb'sudo: a password is required\n?'),
    re.compile(rb'sudo: \d+ incorrect password attempts?\n?'),
    re.compile(rb'sudo: no password was provided\n?'),
]
_FILTER_TAIL = 80  # bytes withheld each pass to catch patterns split across reads

# Markers sudo / pam writes when authentication has failed. Used to
# distinguish auth failure from a successfully-authed command that
# happens to exit non-zero (e.g. `sudo false`, `sudo cat /missing`).
_AUTH_FAIL_PATTERNS = [
    re.compile(rb'Sorry, try again'),
    re.compile(rb'sudo: \d+ incorrect password attempt'),
    re.compile(rb'sudo: no password was provided'),
    re.compile(rb'sudo: a password is required'),
]


def _scrub(data):
    for s in _DROP_STRINGS:
        data = data.replace(s, b'')
    for r in _DROP_RES:
        data = r.sub(b'', data)
    return data


def _pipe_filter(src, dst_fileobj, app=None):
    """Read from a Popen pipe (src), strip known auth chatter, write the
    rest to dst_fileobj.buffer (sys.stdout or sys.stderr).

    sudo writes pam_u2f's cue to *stdout* (via SUDO_CONV_INFO_MSG) and
    the password prompt to *stderr* — we filter both. Real command
    output passes through; the patterns are unique enough that
    collisions with command output are vanishingly unlikely.

    If `app` is provided and the wrapped command has *not* started yet,
    we additionally watch for auth-failure markers and set
    app.auth_failed when one is seen. Restricting detection to the
    pre-cmd window prevents false positives from command output that
    happens to contain similar phrases.
    """
    out = dst_fileobj.buffer
    leftover = b''
    while True:
        try:
            chunk = src.read(4096)
        except Exception:
            break
        if not chunk:
            break
        data = leftover + chunk
        if app is not None and not app.cmd_started and not app.auth_failed:
            for pat in _AUTH_FAIL_PATTERNS:
                if pat.search(data):
                    app.auth_failed = True
                    break
        scrubbed = _scrub(data)
        if len(scrubbed) > _FILTER_TAIL:
            try:
                out.write(scrubbed[:-_FILTER_TAIL])
                out.flush()
            except Exception:
                pass
            leftover = scrubbed[-_FILTER_TAIL:]
        else:
            leftover = scrubbed

    leftover = _scrub(leftover)
    if leftover:
        try:
            out.write(leftover)
            out.flush()
        except Exception:
            pass


def _spawn_filters(proc, app=None):
    """Attach scrub-and-forward threads to proc's stdout and stderr."""
    threading.Thread(
        target=_pipe_filter, args=(proc.stdout, sys.stdout, app),
        daemon=True,
    ).start()
    threading.Thread(
        target=_pipe_filter, args=(proc.stderr, sys.stderr, app),
        daemon=True,
    ).start()

APP_ID = 'io.github.Jackman3005.SudoTouchDialog'
EXIT_CANCEL = 77
BRIDGE = os.path.expanduser('~/.local/bin/sudo-askpass-bridge')


# Pango colors. Picked to read on light or dark Adwaita backgrounds.
_C_SUDO = '#7eb1ff'   # bold blue: the literal `sudo` and the command name
_C_FLAG = '#f0a878'   # warm orange: short/long flags (-x, --foo)
_C_STR = '#a4d57a'    # green: quoted strings
_C_OP = '#d9a3e6'     # purple: shell operators within `bash -c` etc. (best-effort)


def _markup_arg(arg, position):
    """Pango markup for a single shell-quoted argv element.

    position: 0 = command name (highlighted bold), 1+ = subsequent arg.
    """
    quoted = shlex.quote(arg)
    needs_quote = (quoted != arg)
    esc = GLib.markup_escape_text(quoted)

    if position == 0:
        return f'<span foreground="{_C_SUDO}" weight="bold">{esc}</span>'

    # Quoted string literal: highlight the whole thing as a string.
    if needs_quote:
        return f'<span foreground="{_C_STR}">{esc}</span>'

    # Flags: -x, --foo, --foo=bar
    if arg.startswith('-') and len(arg) > 1:
        # If --foo=bar, color the flag part and let bar render plain.
        if '=' in arg:
            flag, _, val = arg.partition('=')
            fe = GLib.markup_escape_text(flag)
            ve = GLib.markup_escape_text(val)
            return f'<span foreground="{_C_FLAG}">{fe}</span>=<span foreground="{_C_STR}">{ve}</span>'
        return f'<span foreground="{_C_FLAG}">{esc}</span>'

    return esc


def highlight_shell(args):
    """Return Pango markup for `sudo <args>` with shell syntax coloring."""
    pieces = [f'<span foreground="{_C_SUDO}" weight="bold">sudo</span>']
    for i, arg in enumerate(args):
        pieces.append(_markup_arg(arg, i))
    return ' '.join(pieces)


def has_yubikey():
    try:
        out = subprocess.check_output(
            ['fido2-token', '-L'],
            stderr=subprocess.DEVNULL, timeout=2,
        )
        return b'hidraw' in out
    except Exception:
        return False


def is_cached():
    return subprocess.call(
        ['sudo', '-n', 'true'],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    ) == 0


class SudoApp(Adw.Application):
    def __init__(self, command):
        super().__init__(
            application_id=APP_ID,
            flags=Gio.ApplicationFlags.NON_UNIQUE,
        )
        self.command = command
        self.exit_code = EXIT_CANCEL
        self.sudo_proc = None
        self.fifo_path = None
        self.fifo_dir = None
        self.password_mode = False
        self.cancelled = False
        self.killed_intentionally = False
        self.state = None
        self._held = False  # whether we've called self.hold() to keep app alive past window close
        self.win = None
        # Set to True once sudo spawns the wrapped command (auth confirmed).
        # Reset before each new sudo invocation so retries (after a wrong
        # password) can detect their own auth outcome independently.
        self.cmd_started = False
        # Set to True by the pipe filter when it sees an auth-failure
        # marker in sudo's output. Used (instead of cmd_started) to
        # decide between retry-prompt and exit-with-rc when sudo exits
        # non-zero.
        self.auth_failed = False

    def do_activate(self):
        if is_cached():
            self.state = 'cached'
        elif has_yubikey():
            self.state = 'touch'
        else:
            self.state = 'password'
        self._build_ui()
        self.win.present()
        if self.state == 'touch':
            GLib.idle_add(self._spawn_sudo_a)

    def _build_ui(self):
        self.win = Adw.ApplicationWindow(application=self)
        self.win.set_title('sudo')
        self.win.set_default_size(560, 280)
        self.win.set_resizable(False)

        kc = Gtk.EventControllerKey()
        kc.connect('key-pressed', self._on_key)
        self.win.add_controller(kc)

        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        header.set_show_end_title_buttons(False)
        header.set_show_start_title_buttons(False)
        toolbar.add_top_bar(header)

        body = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL, spacing=10,
            margin_top=12, margin_bottom=12,
            margin_start=18, margin_end=18,
        )

        caption = Gtk.Label(label='Authorize this command')
        caption.add_css_class('title-3')
        caption.set_halign(Gtk.Align.CENTER)
        body.append(caption)

        # Optional context line: an explanation passed by the caller (e.g.
        # Claude Code) via AGENT_SUDO_REASON. Helps the user know *why*
        # this sudo is being requested.
        reason = os.environ.get('AGENT_SUDO_REASON', '').strip()
        if reason:
            subtitle = Gtk.Label(label=reason)
            subtitle.set_halign(Gtk.Align.CENTER)
            subtitle.set_wrap(True)
            subtitle.set_wrap_mode(2)
            subtitle.set_max_width_chars(60)
            subtitle.add_css_class('dim-label')
            subtitle.set_margin_top(4)
            subtitle.set_margin_bottom(14)
            body.append(subtitle)
        else:
            # Keep the visual gap below the header consistent.
            caption.set_margin_bottom(14)

        cmd = Gtk.Label()
        cmd.set_markup(highlight_shell(self.command))
        cmd.set_wrap(True)
        cmd.set_wrap_mode(2)  # PANGO_WRAP_WORD_CHAR
        cmd.set_max_width_chars(56)  # constrain so it wraps before pushing window edges
        cmd.set_xalign(0)
        cmd.set_selectable(True)
        cmd.add_css_class('monospace')
        body.append(cmd)

        # State indicator: vertical stack, centered. The spinner uses
        # opacity (not visibility) so its 28×28 footprint is always
        # reserved — prevents height shifts between e.g. password input
        # and "Authenticating…".
        self.state_box = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL, spacing=8,
            margin_top=14,
            halign=Gtk.Align.CENTER,
        )
        self.spinner = Gtk.Spinner()
        self.spinner.set_size_request(28, 28)
        self.spinner.set_halign(Gtk.Align.CENTER)
        self.state_box.append(self.spinner)
        self.state_label = Gtk.Label()
        self.state_label.set_halign(Gtk.Align.CENTER)
        self.state_box.append(self.state_label)
        body.append(self.state_box)

        self.pw_entry = Gtk.PasswordEntry()
        self.pw_entry.set_show_peek_icon(True)
        self.pw_entry.connect('activate', lambda e: self._on_ok())
        body.append(self.pw_entry)

        spacer = Gtk.Box(hexpand=True, vexpand=True)
        body.append(spacer)

        btns = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8,
                       halign=Gtk.Align.END)
        self.cancel_btn = Gtk.Button(label='Cancel')
        self.cancel_btn.connect('clicked', lambda b: self._cancel())
        btns.append(self.cancel_btn)

        self.usepw_btn = Gtk.Button(label='Use password')
        self.usepw_btn.connect('clicked', lambda b: self._switch_to_password())
        btns.append(self.usepw_btn)

        self.ok_btn = Gtk.Button(label='Approve')
        self.ok_btn.add_css_class('suggested-action')
        self.ok_btn.connect('clicked', lambda b: self._on_ok())
        btns.append(self.ok_btn)
        body.append(btns)

        toolbar.set_content(body)
        self.win.set_content(toolbar)
        self._apply_state()

    def _set_spinner(self, on):
        # Use opacity (not visibility) so the 28×28 footprint is reserved
        # in both states — keeps height stable across transitions.
        if on:
            self.spinner.set_opacity(1)
            self.spinner.start()
        else:
            self.spinner.stop()
            self.spinner.set_opacity(0)

    def _apply_state(self):
        if self.state == 'cached':
            self._set_spinner(False)
            self.state_label.set_label('Already authenticated — confirm to run.')
            self.pw_entry.set_visible(False)
            self.usepw_btn.set_visible(False)
            self.ok_btn.set_visible(True)
            self.ok_btn.set_label('Approve')
            self.ok_btn.grab_focus()
        elif self.state == 'touch' and not self.password_mode:
            self._set_spinner(True)
            self.state_label.set_label('Tap your YubiKey to authorize…')
            self.pw_entry.set_visible(False)
            self.usepw_btn.set_visible(True)
            self.ok_btn.set_visible(False)
            self.cancel_btn.grab_focus()
        else:
            self._set_spinner(False)
            if not self.state_label.get_label() or 'failed' not in self.state_label.get_label().lower():
                self.state_label.set_label('Enter your password:')
            self.pw_entry.set_visible(True)
            self.pw_entry.set_sensitive(True)
            self.pw_entry.grab_focus()
            self.usepw_btn.set_visible(False)
            self.ok_btn.set_visible(True)
            self.ok_btn.set_label('Authenticate')
            self.ok_btn.set_sensitive(True)

    def _on_key(self, ctrl, keyval, keycode, mods):
        if keyval == Gdk.KEY_Escape:
            self._cancel()
            return True
        return False

    def _on_ok(self):
        if self.state == 'cached':
            threading.Thread(target=self._run_cached, daemon=True).start()
            self.ok_btn.set_sensitive(False)
            self.cancel_btn.set_sensitive(False)
            self._set_spinner(True)
            self.state_label.set_label('Running…')
        elif self.password_mode or self.state == 'password':
            self._submit_password()

    def _switch_to_password(self):
        self.password_mode = True
        self.killed_intentionally = True
        # Flip UI immediately; SIGKILL is just a syscall (fast).
        self.state_label.set_label('Enter your password:')
        self._apply_state()
        self._kill_sudo()

    def _watch_cmd_start(self, proc):
        """Detect when sudo hands off to the wrapped command, then hide
        the dialog so the user's desktop isn't dim_around'ed for the
        duration of long-running commands. The app is held alive so
        _wait_sudo can still report the final exit code."""
        while not self.cancelled and proc.poll() is None:
            try:
                # pgrep -P returns sudo's children. Once sudo has spawned
                # the actual command, auth is done.
                out = subprocess.check_output(
                    ['pgrep', '-P', str(proc.pid)],
                    stderr=subprocess.DEVNULL,
                ).decode().strip()
                if out:
                    GLib.idle_add(self._on_cmd_started)
                    return
            except (subprocess.CalledProcessError, FileNotFoundError):
                pass
            time.sleep(0.15)

    def _on_cmd_started(self):
        if self.cancelled:
            return False
        # Auth done; sudo is now running the wrapped command.
        self.cmd_started = True
        if not self.win:
            return False
        # hold() keeps the GApplication alive once the window closes so
        # _wait_sudo can still propagate the final exit code.
        self.hold()
        self._held = True
        try:
            self.win.close()
        except Exception:
            pass
        self.win = None
        return False

    def _spawn_sudo_a(self):
        # Set up FIFO for the password bridge (only consumed if pam_u2f
        # times out and the user later picks "Use password").
        self.fifo_dir = f'/run/user/{os.getuid()}/sudo-touch-{os.getpid()}'
        try:
            os.makedirs(self.fifo_dir, mode=0o700, exist_ok=True)
        except Exception:
            self.fifo_dir = f'/tmp/sudo-touch-{os.getpid()}'
            os.makedirs(self.fifo_dir, mode=0o700, exist_ok=True)
        self.fifo_path = os.path.join(self.fifo_dir, 'pw.fifo')
        if os.path.exists(self.fifo_path):
            os.unlink(self.fifo_path)
        os.mkfifo(self.fifo_path, mode=0o600)

        env = os.environ.copy()
        env['SUDO_ASKPASS'] = BRIDGE
        env['SUDO_ASKPASS_FIFO'] = self.fifo_path

        self.cmd_started = False
        self.auth_failed = False
        try:
            self.sudo_proc = subprocess.Popen(
                ['sudo', '-A', '--'] + self.command,
                env=env,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
        except FileNotFoundError:
            self.state_label.set_label('sudo not found.')
            return False

        _spawn_filters(self.sudo_proc, app=self)
        threading.Thread(target=self._wait_sudo, daemon=True).start()
        threading.Thread(
            target=self._watch_cmd_start, args=(self.sudo_proc,), daemon=True,
        ).start()
        return False

    def _wait_sudo(self):
        try:
            rc = self.sudo_proc.wait()
        except Exception:
            rc = 1
        GLib.idle_add(self._on_sudo_done, rc)

    def _on_sudo_done(self, rc):
        if self.cancelled:
            return False
        if self.killed_intentionally:
            # We killed sudo to switch modes; drop this exit code — the
            # new sudo (sudo -S) will produce the real one.
            self.killed_intentionally = False
            return False
        if rc != 0 and self.auth_failed:
            # Saw an auth-failure marker before any cmd output → retry.
            self._show_auth_retry()
            return False
        # rc == 0, or cmd ran and exited non-zero. Forward the code.
        self.exit_code = rc
        self._finish()
        return False

    _ERROR_MARKUP = (
        '<span foreground="#f04a4a" weight="bold">'
        'Wrong password — try again:</span>'
    )

    def _show_auth_retry(self):
        """Reset the dialog into password mode with a red retry message."""
        self.password_mode = True
        self._set_spinner(False)
        self.pw_entry.set_text('')
        self.pw_entry.set_sensitive(True)
        self.ok_btn.set_sensitive(True)
        self._apply_state()
        # _apply_state sets a default label for password mode; override it
        # with the red error markup so the user clearly sees the retry.
        self.state_label.set_markup(self._ERROR_MARKUP)
        self.pw_entry.grab_focus()

    def _kill_sudo(self):
        # SIGKILL directly; SIGTERM would queue behind pam_u2f's blocking
        # libfido2 call (which has no async cancel) and effectively wait
        # for the device timeout. SIGKILL bypasses that — kernel tears
        # down the process and closes /dev/hidraw immediately. Just the
        # syscall, no wait — zombies will be reaped on process exit.
        proc = self.sudo_proc
        self.sudo_proc = None
        if proc is None or proc.poll() is not None:
            return
        try:
            proc.kill()
        except (ProcessLookupError, PermissionError):
            pass

    def _submit_password(self):
        pw = self.pw_entry.get_text()
        if not pw:
            return
        self.pw_entry.set_text('')
        self.pw_entry.set_sensitive(False)  # disable, but keep visible to hold layout
        self.ok_btn.set_sensitive(False)
        self.state_label.set_label('Authenticating…')
        self._set_spinner(True)

        threading.Thread(
            target=self._run_sudo_s, args=(pw,), daemon=True,
        ).start()

    def _run_sudo_s(self, pw):
        try:
            self.cmd_started = False
            self.auth_failed = False
            p = subprocess.Popen(
                ['sudo', '-S', '--'] + self.command,
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
            self.sudo_proc = p
            _spawn_filters(p, app=self)
            threading.Thread(
                target=self._watch_cmd_start, args=(p,), daemon=True,
            ).start()
            # Send pw via stdin, then close it so the command can read its
            # own stdin (if any) from the inherited descriptor.
            try:
                p.stdin.write((pw + '\n').encode())
                p.stdin.close()
            except Exception:
                pass
            rc = p.wait()
        except Exception:
            rc = 1
        GLib.idle_add(self._on_sudo_done_pw, rc)

    def _run_cached(self):
        try:
            self.cmd_started = False
            self.auth_failed = False
            p = subprocess.Popen(
                ['sudo', '-n', '--'] + self.command,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
            self.sudo_proc = p
            _spawn_filters(p, app=self)
            threading.Thread(
                target=self._watch_cmd_start, args=(p,), daemon=True,
            ).start()
            rc = p.wait()
        except Exception:
            rc = 1
        GLib.idle_add(self._on_sudo_done_pw, rc)

    def _on_sudo_done_pw(self, rc):
        if self.cancelled:
            return False
        if rc != 0 and self.auth_failed:
            self._show_auth_retry()
            return False
        self.exit_code = rc
        self._finish()
        return False

    def _cancel(self):
        if self.cancelled:
            return
        self.cancelled = True
        self.exit_code = EXIT_CANCEL
        self._kill_sudo()
        self._finish()

    def _finish(self):
        self._cleanup_fifo()
        if self.win is not None:
            try:
                self.win.close()
            except Exception:
                pass
            self.win = None
        if self._held:
            try:
                self.release()
            except Exception:
                pass
            self._held = False
        self.quit()

    def _cleanup_fifo(self):
        if self.fifo_path and os.path.exists(self.fifo_path):
            try:
                os.unlink(self.fifo_path)
            except Exception:
                pass
        if self.fifo_dir and os.path.isdir(self.fifo_dir):
            try:
                os.rmdir(self.fifo_dir)
            except Exception:
                pass


def main():
    if '--' in sys.argv:
        idx = sys.argv.index('--')
        cmd = sys.argv[idx + 1:]
    else:
        cmd = sys.argv[1:]
    if not cmd:
        print('Usage: sudo-touch-dialog -- <command...>', file=sys.stderr)
        sys.exit(2)

    app = SudoApp(cmd)
    app.run([])
    sys.exit(app.exit_code)


if __name__ == '__main__':
    main()
